rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = the IT lead's account only.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'mouad.aboussiber@vpscorp.ma';
    }

    // Only signed-in team members can read or change tasks.
    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.owner is string
        && request.resource.data.hours is number;
      allow delete: if request.auth != null;
    }

    // Astreinte planning: the team can read it, only the admin can change it.
    match /astreinte/{monthId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Remuneration amounts: admin only (nobody else can read or write).
    match /astreinte_admin/{monthId} {
      allow read, write: if isAdmin();
    }

    // Leave / sick days: any signed-in team member can log and read; only the
    // admin (or the same rule as tasks, any signed-in user) can validate/delete.
    match /leaves/{leaveId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.start is string
        && request.resource.data.end is string;
      allow delete: if request.auth != null;
    }

    // Incident reports: any signed-in team member can log, read and close.
    match /incidents/{incidentId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.declDate is string
        && request.resource.data.category is string
        && request.resource.data.severity is string;
      allow delete: if request.auth != null;
    }
  }
}
